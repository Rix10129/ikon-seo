{
  "openapi": "3.1.0",
  "info": {
    "title": "Ikon SEO",
    "version": "0.6.0",
    "description": "Universal website profiles, simple one-time pairing, Local SEO safeguards, Google Business Profile insights, Search Console, page-plan queues and approval-first optimization."
  },
  "servers": [
    {
      "url": "https://YOUR-WEBSITE.example/wp-json/ikon-seo/v1"
    }
  ],
  "security": [],
  "paths": {
    "/pair": {
      "post": {
        "operationId": "pairIkonSEOWebsite",
        "summary": "Exchange a short-lived one-time pairing code for the website connection package",
        "security": [],
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "example": "ABCD-2345"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One-time connection package"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "checkIkonSEOConnection",
        "summary": "Check installation and capabilities",
        "responses": {
          "200": {
            "description": "Connection status"
          }
        },
        "parameters": [
          {
            "name": "X-Ikon-SEO-Key",
            "in": "header",
            "required": true,
            "description": "Connection key returned by pairIkonSEOWebsite. Keep it private and send it on every authenticated request.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
