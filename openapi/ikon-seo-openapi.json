  "components": {
    "securitySchemes": {
      "IkonSEOKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Ikon-SEO-Key"
      }
    },
    "parameters": {
      "PageId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "Idempotency": {
        "name": "X-Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "Button": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "FAQ": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      },
      "Section": {
        "type": "object",
        "required": [
          "type",
          "heading"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "content",
              "cards",
              "features",
              "checklist",
              "table",
              "process",
              "faq",
              "related-links",
              "cta",
              "split-content",
              "stats",
              "trust",
              "documents",
              "notice",
              "expert",
              "sources",
              "location-details",
              "service-area",
              "map",
              "local-proof",
              "reviews"
            ]
          },
          "eyebrow": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "intro": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "map_query": {
            "type": "string"
          },
          "map_url": {
            "type": "string",
            "format": "uri"
          },
          "map_embed_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional HTTPS www.google.com/maps/embed URL."
          },
          "map_label": {
            "type": "string"
          },
          "map_zoom": {
            "type": "integer",
            "minimum": 5,
            "maximum": 20
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "button": {
            "$ref": "#/components/schemas/Button"
          }
        }
      },
      "SEO": {
        "type": "object",
        "required": [
          "title",
          "description",
          "focus_keyword"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "focus_keyword": {
            "type": "string"
          },
          "canonical": {
            "type": "string",
            "format": "uri"
          },
          "robots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SchemaConfig": {
        "type": "object",
        "properties": {
          "page_type": {
            "type": "string",
            "enum": [
              "webpage",
              "service",
              "article",
              "profile",
              "collection",
              "tool",
              "about",
              "contact",
              "location",
              "howto"
            ]
          },
          "semantic_faq": {
            "type": "boolean"
          },
          "service": {
            "type": "object",
            "additionalProperties": true
          },
          "business_entity": {
            "type": "object",
            "description": "Type is always controlled by the active Website Profile.",
            "additionalProperties": true
          },
          "breadcrumbs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "article": {
            "type": "object",
            "additionalProperties": true
          },
          "person": {
            "type": "object",
            "additionalProperties": true
          },
          "collection": {
            "type": "object",
            "additionalProperties": true
          },
          "application": {
            "type": "object",
            "additionalProperties": true
          },
          "howto": {
            "type": "object",
            "additionalProperties": true
          },
          "video": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "LocalPage": {
        "type": "object",
        "description": "Required for local location pages. Service areas cannot expose an address or location entity.",
        "required": [
          "location_id",
          "page_kind",
          "services",
          "unique_local_details"
        ],
        "properties": {
          "location_id": {
            "type": "integer"
          },
          "page_kind": {
            "type": "string",
            "enum": [
              "verified_location",
              "service_area"
            ]
          },
          "target_area": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unique_local_details": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "directions": {
            "type": "string"
          },
          "parking": {
            "type": "string"
          },
          "map_url": {
            "type": "string",
            "format": "uri"
          },
          "show_address": {
            "type": "boolean"
          },
          "emit_location_entity": {
            "type": "boolean"
          }
        }
      },
      "PagePayload": {
        "type": "object",
        "required": [
          "profile_id",
          "title",
          "sections",
          "seo"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "description": "Current value returned by GET /profile."
          },
          "mode": {
            "type": "string",
            "enum": [
              "create",
              "improve"
            ]
          },
          "source_page_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "hero": {
            "type": "object",
            "additionalProperties": true
          },
          "sections": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "$ref": "#/components/schemas/Section"
            }
          },
          "faq": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/FAQ"
            }
          },
          "seo": {
            "$ref": "#/components/schemas/SEO"
          },
          "schema": {
            "$ref": "#/components/schemas/SchemaConfig"
          },
          "local": {
            "$ref": "#/components/schemas/LocalPage"
          },
          "content_review": {
            "type": "object",
            "additionalProperties": true
          },
          "featured_media_id": {
            "type": "integer"
          },
          "social_media_id": {
            "type": "integer"
          }
        }
      },
      "MediaImport": {
        "type": "object",
        "required": [
          "source_url",
          "alt_text"
        ],
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "filename": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "alt_text": {
            "type": "string"
          }
        }
      },
      "QueueCompletion": {
        "type": "object",
        "required": [
          "claim_token",
          "page"
        ],
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 32,
            "description": "One-time token returned by the claim operation. Expires after one hour."
          },
          "page": {
            "$ref": "#/components/schemas/PagePayload"
          }
        }
      },
      "Rollback": {
        "type": "object",
        "properties": {
          "snapshot_id": {
            "type": "string",
            "description": "Optional. The newest snapshot is used when omitted."
          }
        }
      },
      "UTMRequest": {
        "type": "object",
        "required": [
          "url",
          "campaign"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string",
            "default": "google"
          },
          "medium": {
            "type": "string",
            "default": "organic"
          },
          "campaign": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "term": {
            "type": "string"
          }
        }
      },
      "GBPDraft": {
        "type": "object",
        "description": "Stages content locally. Sending is only available from WordPress after exact administrator approval.",
        "required": [
          "profile_id",
          "location_id",
          "draft_type",
          "content"
        ],
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "location_id": {
            "type": "integer"
          },
          "draft_type": {
            "type": "string",
            "enum": [
              "review_reply",
              "google_post"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 4000
          },
          "review_name": {
            "type": "string"
          },
          "topic_type": {
            "type": "string",
            "enum": [
              "STANDARD",
              "EVENT",
              "OFFER"
            ]
          },
          "call_to_action": {
            "type": "string"
          },
          "call_to_action_url": {
            "type": "string",
            "format": "uri"
          },
          "event_title": {
            "type": "string"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
